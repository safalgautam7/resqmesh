# ResQMesh backend environment (copy to .env and fill real values; never commit .env)

# Django
DJANGO_SECRET_KEY=change-me-in-prod-really-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Database
DATABASE_URL=postgres://resqmesh:resqmesh@localhost:5432/resqmesh

# AI provider: one of mock | ollama | hosted
AI_PROVIDER=mock
AI_MODEL=qwen2.5-coder:1.5b
OLLAMA_URL=http://localhost:11434
AI_API_KEY=
AI_BASE_URL=
